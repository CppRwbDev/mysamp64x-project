<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:id="@+id/dialog_error"
    android:background="@drawable/dialog_client"
    android:paddingTop="12.0dip"
    android:paddingBottom="16.0dip"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/dw_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:fontFamily="@font/ttnorms"
        android:singleLine="true"
        android:text="Ошибка!"
        android:textColor="#ffffffff"
        android:textSize="14dp" />

    <androidx.core.widget.NestedScrollView android:scrollbarThumbHorizontal="@android:color/transparent" android:scrollbarThumbVertical="@android:color/transparent" android:scrollbarTrackHorizontal="@android:color/transparent" android:scrollbarTrackVertical="@android:color/transparent" android:id="@+id/dw_scroll_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="0.0dip" android:layout_marginLeft="20.0dip" android:layout_marginTop="13.0dip" android:layout_marginRight="20.0dip" android:layout_weight="0.5" android:overScrollMode="never">
        <TextView android:textSize="10.0sp" android:textColor="#ffffffff" android:id="@+id/dw_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Info\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\nInfo\n" android:lineSpacingExtra="3.0sp" android:fontFamily="@font/ttnorms" />
    </androidx.core.widget.NestedScrollView>

    <TextView android:textSize="13.0sp"
        android:textColor="#ffffffff"
        android:textColorHint="#ffffffff"
        android:gravity="left"
        android:id="@+id/dw_edittext"
        android:paddingLeft="14.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="14.0dip"
        android:paddingBottom="6.0dip"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="16.0dip"
        android:layout_marginRight="20.0dip"
        android:hint="У вас отствует подключение к интернету."
        android:ems="10" android:singleLine="true"
        android:inputType="textEmailAddress"
        android:imeOptions="actionSend|flagNoExtractUi|flagNoFullscreen"
        android:fontFamily="@font/ttnorms" />

    <LinearLayout
        android:id="@+id/dw_root_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginLeft="20.0dip"
        android:layout_marginRight="20.0dip"
        android:layout_marginTop="16.0dip"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/dialog_samp_button"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ttnorms"
                android:gravity="center"
                android:text="Закрыть"
                android:textColor="#ffffff"
                android:textSize="15dp"
                android:textStyle="bold" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16.0dip"
            android:background="@drawable/dialog_samp_button"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ttnorms"
                android:gravity="center"
                android:text="Закрыть"
                android:textColor="#ffffff"
