<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bac"
    tools:context="com.flin.online.SetingsActivity">

    <ScrollView
        android:id="@+id/myview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

        <TextView
        android:id="@+id/textViewVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/ttnorms"
        android:gravity="center"
        android:text="v4.0 (Build 23)"
        android:textColor="#7c8080"
        android:textSize="8dp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/ttnorms"
        android:gravity="center"
        android:text="Настройки"
        android:textColor="#404242"
        android:textSize="15dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ttnorms"
                android:gravity="center"
                android:text="Ваш никнейм:"
                android:textColor="#404242"
                android:textSize="15dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.202"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView11" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ttnorms"
        android:gravity="center"
        android:text="Прочие:"
        android:textColor="#404242"
        android:textSize="15dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/textView7"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutMods" />

    <TextView
        android:id="@+id/textView16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ttnorms"
        android:gravity="center"
        android:text="Расположение игры:"
        android:textColor="#404242"
        android:textSize="15dp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutDonate" />

    <TextView
        android:id="@+id/textViewStaticFontName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ttnorms"
        android:gravity="center"
        android:text="Шрифт игры:"
        android:textColor="#404242"
        android:textSize="15dp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutChangePath" />


    <LinearLayout
        android:id="@+id/linearLayoutChangeFont"
        android:layout_width="264dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:background="@drawable/bac_input"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewStaticFontName">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <TextView
                android:id="@+id/textviewChangeFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center"
                android:fontFamily="@font/ttnorms"
                android:gravity="center"
                android:text="Arial"
                android:textColor="@color/colorBlack"
                android:textSize="14dp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageChangeFontBack"
                android:layout_width="23dp"
                android:layout_height="27dp"
                android:layout_marginStart="30dp"
                android:layout_weight="0"
                android:src="@drawable/donate_back"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/imageChangeFontNext"
                android:layout_width="23dp"
                android:layout_height="27dp"
                android:layout_marginEnd="30dp"
                android:layout_weight="0"
                android:src="@drawable/donate_next"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>


    <TextView
        android:id="@+id/textViewNameMods"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ttnorms"
        android:gravity="center"
        android:text="Сборка:"
        android:textColor="#404242"
        android:textSize="15dp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutChangeFont" />

    <LinearLayout
        android:id="@+id/linearLayoutMods"
        android:layout_width="264dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:background="@drawable/bac_input"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewNameMods">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <TextView
                android:id="@+id/textViewMods"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center"
                android:fontFamily="@font/ttnorms"
                android:gravity="center"
                android:text="Стандарт"
                android:textColor="@color/colorBlack"
                android:textSize="14dp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageBackMods"
                android:layout_width="23dp"
                android:layout_height="27dp"
                android:layout_marginStart="30dp"
                android:src="@drawable/donate_back"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/textViewModsNext"
                android:layout_width="23dp"
                android:layout_height="27dp"
                android:layout_marginEnd="30dp"
                android:src="@drawable/donate_next"
                app:layout_constraintEnd_toEndOf="parent"
                tools:layout_editor_absoluteY="-1dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>


    <LinearLayout
        android:id="@+id/linearLayoutChangePath"
        android:layout_width="264dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:background="@drawable/bac_input"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView16">

        <ImageView
            android:id="@+id/imageChangePathBack"
            android:layout_width="17dp"
            android:layout_height="25dp"
            android:layout_weight="2"
            android:src="@drawable/donate_back" />
        <TextView
            android:id="@+id/textviewChangePath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center"
            android:fontFamily="@font/ttnorms"
            android:gravity="center"
            android:text="Телефон"
            android:textColor="@color/colorBlack"
            android:textSize="14dp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <ImageView
            android:id="@+id/imageChangePathNext"
            android:layout_width="17dp"
            android:layout_height="25dp"
            android:layout_weight="2"
            android:src="@drawable/donate_next" />


    </LinearLayout>

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ttnorms"
                android:gravity="center"
                android:text="Версия клиента:"
                android:textColor="#404242"
                android:textSize="15dp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/textView7"
                app:layout_constraintTop_toBottomOf="@+id/imageViewSaveNick" />

            <EditText
                android:id="@+id/editTextChangeName"
                android:layout_width="264dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bac_input"
                android:ems="24"
                android:gravity="center"
                android:hint="Например: Nick_Name"
                android:inputType="textPersonName"
                android:textColor="@color/colorMainApp"
                android:textColorHint="#E1E1E1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView7" />


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9">



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <Switch
                android:id="@+id/switch2"
                android:layout_width="241dp"
                android:layout_height="29dp"
                android:text="Уведомления"
                android:textColor="@color/colorMainApp"
                android:textSize="15dp"
                android:textStyle="normal" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <Switch
                android:id="@+id/switchGraphics"
                android:layout_width="241dp"
                android:layout_height="29dp"
                android:text="Улучшенная графика"
                android:textColor="@color/colorMainApp"
                android:textSize="15dp"
                android:textStyle="normal" />
        </LinearLayout>

    </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutDonate"
                android:layout_width="264dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:background="@drawable/bac_input"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="2">

                    <ImageView
                        android:id="@+id/imageDonateNext"
                        android:layout_width="23dp"
                        android:layout_height="27dp"
                        android:layout_marginEnd="30dp"
                        android:src="@drawable/donate_next"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/textviewDonateSelectServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|center"
                        android:fontFamily="@font/ttnorms"
                        android:gravity="center"
                        android:text="Стабильная"
                        android:textColor="@color/colorBlack"
                        android:textSize="14dp"
                        android:textStyle="normal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/imageDonateBack"
                        android:layout_width="23dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="30dp"
                        android:src="@drawable/donate_back"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </LinearLayout>


            <ImageView
                android:id="@+id/imageViewSaveNick"
                android:layout_width="122dp"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/icon_save_nick"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextChangeName" />

            <LinearLayout
                android:id="@+id/linearLayoutReinstallGame"
                android:layout_width="136dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_background_all_group"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/ttnorms"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#AFAEAE"
                        android:shadowRadius="4"
                        android:text="Переустановить игру"
                        android:textAllCaps="false"
                        android:textColor="@color/colorWhite"
                        android:textSize="10dp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/linearLayoutManagerPassword"
                android:layout_width="136dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="50dp"
                android:background="@drawable/btn_background_all_group"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayoutCheckFiles">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/ttnorms"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#AFAEAE"
                        android:shadowRadius="4"
                        android:text="Менеджер паролей"
                        android:textAllCaps="false"
                        android:textColor="@color/colorWhite"
                        android:textSize="10dp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/linearLayoutCheckFiles"
                android:layout_width="136dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_background_all_group"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayoutReinstallGame">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/ttnorms"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#AFAEAE"
                        android:shadowRadius="4"
                        android:text="Проверка файлов игры"
                        android:textAllCaps="false"
                        android:textColor="@color/colorWhite"
                        android:textSize="10dp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayoutManagerPassword">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView41"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="25dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#AFAEAE"
                        android:shadowRadius="4"
                        android:text="Нашел ошибку?"
                        android:textAllCaps="false"
                        android:textColor="#303030"
                        android:textSize="12dp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/buttonSendTechMsg"
                            android:layout_width="90dp"
                            android:layout_height="31dp"
                            android:background="@drawable/btn_background"
                            android:maxLines="1"
                            android:shadowColor="#AFAEAE"
                            android:shadowRadius="4"
                            android:text="Сообщить"
                            android:textAllCaps="false"
                            android:textColor="@color/colorWhite"
                            android:textSize="10dp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </LinearLayout>




        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <include
        android:id="@+id/include"
        layout="@layout/i_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>