<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@id/main_fl_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_gravity="bottom">

    <SurfaceView
        android:id="@id/main_sv"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/textView31"
            android:layout_width="176dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="TextView"
            android:textColor="@color/colorMain"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@id/ui_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:visibility="visible">

            <LinearLayout
                android:id="@id/main_input"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:alpha="1.0"
                android:background="#a2ffffff"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="15.0dip"
                android:paddingRight="15.0dip"
                android:visibility="visible">

                <Button
                    android:id="@id/main_but_input_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:minWidth="11.0dip"
                    android:minHeight="11.0dip"
                    android:text="⋁"
                    android:textSize="14.0sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@id/main_but_input_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:minWidth="11.0dip"
                    android:minHeight="11.0dip"
                    android:text="⋀"
                    android:textSize="14.0sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@id/main_but_input_slash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:minWidth="11.0dip"
                    android:minHeight="11.0dip"
                    android:text="/"
                    android:textSize="14.0sp"
                    android:textStyle="bold" />

                <com.nvidia.devtech.CustomEditText
                    android:id="@id/main_et_input"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="15.0dip"
                    android:layout_weight="0.7"
                    android:ems="10"
                    android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@android:color/black"
                    android:textSize="14.0sp" />
            </LinearLayout>

            <View
                android:id="@id/dark_screen"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:alpha="0.0"
                android:background="#ff000000"
                android:visibility="visible" />

            <include
                layout="@layout/bhud_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/bloading_screen"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/hassle_tab"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/connect_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">


        <LinearLayout
            android:id="@+id/linearLayout4"
            android:layout_width="392dp"
            android:layout_height="231dp"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/imageView33"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewConnectNameTitle">

            <LinearLayout
                android:id="@+id/linearConnectServerOne"
                android:layout_width="177dp"
                android:layout_height="224dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/ic_we"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/buttonConnectOneSever"
                        android:layout_width="138dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/background_flin_server_button"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.483"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="91dp"
                        android:layout_height="91dp"
                        android:background="@drawable/flin_dialog_background_rectangle"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintBottom_toTopOf="@+id/buttonConnectOneSever"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textViewConnectOne">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/textViewConnectOnlineOne"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/roboto_regular"
                                android:text="1000/1000"
                                android:textColor="#ffffff"
                                android:textSize="8dp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_bias="0.49"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/imageViewOneServer" />

                            <ImageView
                                android:id="@+id/imageViewOneServer"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginBottom="6dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/background_flin_server_icon" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textViewConnectOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_horizontal"
                        android:text="SERVER #1"
                        android:textColor="#ffffff"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearConnectServerTwo"
                android:layout_width="177dp"
                android:layout_height="224dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/ic_we"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/buttonConnectTwoSever"
                        android:layout_width="138dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/background_flin_server_button"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.483"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="91dp"
                        android:layout_height="91dp"
                        android:background="@drawable/flin_dialog_background_rectangle"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintBottom_toTopOf="@+id/buttonConnectTwoSever"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textViewConnectOne">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/textViewConnectOnlineTwo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/roboto_regular"
                                android:text="1000/1000"
                                android:textColor="#ffffff"
                                android:textSize="8dp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_bias="0.49"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/imageViewTwoServer" />

                            <ImageView
                                android:id="@+id/imageViewTwoServer"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginBottom="6dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/background_flin_server_icon" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textViewConnectOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_horizontal"
                        android:text="SERVER #2"
                        android:textColor="#ffffff"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imageView33"
            android:layout_width="186dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/background_flin_server_connect_name" />

        <ImageView
            android:id="@+id/imageViewTestServer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/background_flin_server_test" />


        <ImageView
            android:id="@+id/imageViewTestSelectServer1"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:layout_marginEnd="32dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/imageViewTestSelectServer2"
            app:layout_constraintEnd_toStartOf="@+id/imageViewTestSelectServer2"
            app:layout_constraintTop_toTopOf="@+id/imageViewTestSelectServer2"
            app:layout_constraintVertical_bias="0.0"
            app:srcCompat="@drawable/port5555" />

        <ImageView
            android:id="@+id/imageViewTestSelectServer2"
            android:layout_width="48dp"
            android:layout_height="37dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="12dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/imageViewTestServer"
            app:layout_constraintEnd_toStartOf="@+id/imageViewTestServer"
            app:layout_constraintTop_toTopOf="@+id/imageViewTestServer"
            app:layout_constraintVertical_bias="0.0"
            app:srcCompat="@drawable/port5557" />


        <TextView
            android:id="@+id/textViewConnectNameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:text="Выберите сервер для игры"
            android:textColor="#ffffff"
            android:textSize="12dp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewIranConnect"
            android:layout_width="119dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/icon_iran" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/gme_web_donate" />
</FrameLayout>