<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/allDialogs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="vertical"
    android:visibility="gone">


    <FrameLayout
        android:id="@+id/contentButtonAdmin"
        android:layout_width="41dp"
        android:layout_height="24dp"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="8dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toStartOf="@+id/content"
        app:layout_constraintTop_toBottomOf="@+id/title">

        <ImageButton
            android:id="@+id/contentButtonImageAdmin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/flin_dialog_button_one"
            android:text="kek" />

        <TextView
            android:id="@+id/contentButtonTextImageAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/gilroybold"
            android:text="ok"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/contentButtonAutoLogin"
        android:layout_width="108dp"
        android:layout_height="21dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="90dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toStartOf="@+id/content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/contentButtonImageAutoLogin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/flin_dialog_button_one" />

        <TextView
            android:id="@+id/contentButtonTextAutoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/gilroybold"
            android:gravity="center"
            android:text=" Автоввод >> "
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="168dp"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="168dp"
        android:background="@drawable/flin_dialog_title_background"
        android:paddingLeft="5dp"
        android:paddingTop="10dp"
        android:paddingRight="5dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/gilroybold"
            android:singleLine="true"
            android:text="Title"
            android:textSize="14dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:background="@drawable/flin_dialog_content_background_color"
        android:minHeight="130dp"
        android:minWidth="400dp"
        android:paddingLeft="2dp"
        android:paddingRight="20dp"
        android:paddingTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.71000004">


        <FrameLayout
            android:id="@+id/contentInputBox"
            android:layout_width="350dp"
            android:layout_height="25dp"
            android:layout_marginBottom="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/flin_dialog_input_box_background"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/contentButtons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contentCardScrollText">

            <TextView
                android:id="@+id/contentInputBoxText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentStart="true"
                android:layout_gravity="center"
                android:background="@null"
                android:fontFamily="@font/gilroybold"
                android:foregroundGravity="center"
                android:gravity="center"
                android:hint="Нажмите для ввода"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#4DFFFFFF"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/contentScrollBar"
            android:layout_width="13dp"
            android:layout_height="80dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/flin_dialog_scrollbar_background"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/contentCardScrollText"
            app:layout_constraintTop_toBottomOf="@+id/contentHeaderList"
            app:layout_constraintVertical_bias="0.0">

            <FrameLayout
                android:id="@+id/contentScrollBarSlider"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/flin_dialog_scrollbar_slider"
                android:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/contentButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contentCardScrollText"
            app:layout_constraintVertical_bias="0.9">

            <FrameLayout
                android:id="@+id/contentButtonLayoutTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:visibility="visible">

                <ImageButton
                    android:id="@+id/contentButtonImageTwo"
                    android:layout_width="150dp"
                    android:layout_height="35dp"
                    android:background="@drawable/flin_dialog_button_two" />

                <TextView
                    android:id="@+id/contentButtonTextTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/gilroybold"
                    android:text="Закрыть"
                    android:textColor="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/contentButtonLayoutOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp">

                <ImageButton
                    android:id="@+id/contentButtonImageOne"
                    android:layout_width="150dp"
                    android:layout_height="35dp"
                    android:background="@drawable/flin_dialog_button_one"
                    android:text="kek" />

                <TextView
                    android:id="@+id/contentButtonTextOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/gilroybold"
                    android:text="Закрыть"
                    android:textColor="#FFFFFF" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/contentHeaderList"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="18dp"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/contentCardScrollText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <TextView
                android:id="@+id/textView17"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/gilroybold"
                android:gravity="center_vertical"
                android:text="111111111111111111111111111111111111111111111111111111111111111111"
                android:textColor="#ABABAB"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/gilroybold"
                android:gravity="center_vertical"
                android:text="111111"
                android:textColor="#ABABAB"
                android:textSize="10dp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/contentCardScrollText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:visibility="visible"
            app:cardBackgroundColor="#00FFFFFF"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <ScrollView
                android:id="@+id/contentScrollList"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:fadeScrollbars="false"

                android:scrollbars="none"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.23000002">

                <LinearLayout
                    android:id="@+id/contentLinearList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="350dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView26"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_left"
                            android:backgroundTint="#40000000"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:paddingLeft="5dp"
                            android:text="#!"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView27"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_left"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:paddingLeft="5dp"
                            android:text="#!111"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView32"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_left"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:paddingLeft="5dp"
                            android:text="#!"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView33"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_left"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:paddingLeft="5dp"
                            android:text="#!"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView34"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_left"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:paddingLeft="5dp"
                            android:text="#!"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView25"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_right"
                            android:backgroundTint="#40000000"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:text="\t#!"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView28"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_right"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:text="\t#!111"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView35"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_right"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:text="\t#!111"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView36"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_right"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:text="\t#!111"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                        <TextView
                            android:id="@+id/textView37"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/flin_dialog_list_item_background_right"
                            android:fontFamily="@font/gilroybold"
                            android:gravity="center_vertical"
                            android:text="\t#!111"
                            android:textColor="#FFFFFF"
                            android:textSize="9dp" />

                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/contentScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fadeScrollbars="false"

                android:scrollbars="none"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.23000002">

                <LinearLayout
                    android:id="@+id/contentTextScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/contentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroybold"
                        android:minWidth="350dp"
                        android:singleLine="false"
                        android:text="Content text"
                        android:textAlignment="textStart"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />

                </LinearLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>