        android:label="@string/app_name"
        android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar.FullScreen"
        android:windowSoftInputMode="adjustNothing" />
    <activity
        android:name="com.flin.online.GTASA"
        android:screenOrientation="landscape"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar.FullScreen">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

    <meta-data
        android:name="android.max_aspect"
        android:value="2.1" />
    <meta-data
        android:name="com.yandex.metrica.push.default_notification_icon"
        android:resource="@drawable/ic_launcher" />
    <meta-data
        android:name="io.sentry.dsn"
        android:value="https://8cc6b2c838ad4f32b77bbfc4c76d3933@o953864.ingest.sentry.io/5902745" />
    <!-- https://a9e5f9b2adb34e4389860fc082ca10cb@o1343812.ingest.sentry.io/6619118 -->
