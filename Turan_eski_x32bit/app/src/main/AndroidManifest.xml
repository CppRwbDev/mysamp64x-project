        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.MeniDown"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.Snap"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.getGPU"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.test"
        android:screenOrientation="landscape"
        android:theme="@style/AppTheme" />
    <activity android:name="com.flin.online.WebView" />
    <activity
        android:name="com.flin.online.ReOpenInstallActivity"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme">
        <intent-filter>
            <action android:name="com.flin.online.INSTALLGAME" />

            <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
    </activity>
    <activity
        android:name="com.flin.online.PushOpen"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />

            <data
                android:host="donate"
                android:scheme="flingame" />
        </intent-filter>
    </activity>
    <activity
        android:name="com.flin.online.InstallAPKActivity"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.ReUpdateClient"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.ReUpdateClientCop"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.WebDonateActivity"
