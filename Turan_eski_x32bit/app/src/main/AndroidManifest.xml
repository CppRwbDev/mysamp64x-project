        android:name="com.flin.online.IntallNickActivity"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.LoadingGPU"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.MenuActivity"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.LoadingApp"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.install.InstallClient"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
        android:name="com.flin.online.MainStart"
        android:screenOrientation="portrait"
        android:theme="@style/AppTheme" />
    <activity
